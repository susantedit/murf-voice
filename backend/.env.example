# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Exercise service — Day 5 tool failure simulation
# Set to 1 to simulate the exercise service being unavailable.
# Vidya will respond: "I'm having trouble loading a new exercise right now."
# Unset or set to 0 for normal operation.
# -----------------------------------------------------------------------------
# EXERCISE_SERVICE_DISABLED=1

# ── Day 6: Outbound SIP Calling ─────────────────────────────────────────────
#
# Linphone setup:
#   1. Download Linphone desktop: https://www.linphone.org/en/download
#   2. Create a free SIP account at https://sip.linphone.org
#   3. Register Linphone with your sip.linphone.org credentials
#   4. Your SIP URI will be: sip:username@sip.linphone.org
#
# LiveKit SIP Trunk:
#   1. Go to your LiveKit Cloud dashboard → SIP → Outbound Trunks
#   2. Create an outbound trunk pointing to sip.linphone.org
#   3. Copy the trunk ID below
#
# LIVEKIT_SIP_TRUNK_ID is required for SIP calling.
# When absent, dispatch_outbound_sip_call returns {"success": false, "error": "no_sip_trunk"}
# and all Day 1–5 inbound features continue to work normally.
LIVEKIT_SIP_TRUNK_ID=

# Set to 1 to start the call scheduler alongside the agent worker.
# When 0 or absent, no outbound calls are scheduled.
SCHEDULER_ENABLED=0

# Set to 1 to simulate Linphone being unavailable (for testing failure paths).
# dispatch_outbound_sip_call returns {"success": false, "error": "simulated_unavailable"}.
LINPHONE_UNAVAILABLE_SIMULATION=0


# Day 7 — Human Escalation / Discord Notifications
# ─────────────────────────────────────────────────
# When set, Vidya will POST a formatted embed to this Discord channel
# whenever a Teacher Support Request is created.
#
# How to get a webhook URL:
#   1. Open your Discord server → Channel Settings → Integrations → Webhooks
#   2. Click "New Webhook", choose a channel, copy the Webhook URL.
#   3. Paste it here.
#
# Leave blank (or remove) to disable Discord notifications entirely.
# The backend starts and all other features work without this variable.
DISCORD_WEBHOOK_URL=
